# Product deliverables must be paid for and downloaded through
# api/download.php (which checks a per-purchase token) — never served
# directly, or anyone could guess a product's file URL and skip paying.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
