# ============================================================================
# iamtomley — Apache configuration
# Clean URLs (hide .php) + lock down source files against download/scraping.
# ============================================================================

# No directory listings, no content-negotiation guessing, no version banner
Options -Indexes -MultiViews
ServerSignature Off

DirectoryIndex index.php index.html

# ── Security headers (fallback for static files; PHP also sets these) ──────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  <FilesMatch "\.(php|inc)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# ── Block download of source, data, backups and internals ────────────────
# App internals & database directories
RedirectMatch 403 ^/?(?:data|includes)(?:/.*)?$
RedirectMatch 403 ^/?config(?:\.local)?\.php$

# Sensitive / non-public file types (NOT .php — those must execute)
<FilesMatch "\.(?:db|db-wal|db-shm|sqlite|sql|log|bak|old|swp|inc|ini|env|dist|sh|lock|md|twig|tpl)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>

# Specific config / dependency manifests
<FilesMatch "^(?:config\.php|config\.local\.php|composer\.(?:json|lock)|package(?:-lock)?\.json|\.env.*|\.gitignore|\.htaccess)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>

# Hidden dot-files/folders (.git, .env, …) — allow only .well-known
RedirectMatch 404 (?:^|/)\.(?!well-known)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # robots.txt and sitemap.xml are generated by PHP so they always match the
  # site's current state (maintenance mode, "discourage search engines", the
  # project images to index). Must come before the .php-hiding rules below.
  RewriteRule ^robots\.txt$  robots.php  [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Resolve directory front-controllers even without a trailing slash
  # (so /install and /admin work, not just /install/ and /admin/).
  RewriteRule ^(admin|install)/?$ $1/index.php [L]

  # Block PHP (and lookalikes) from executing inside uploads/
  RewriteRule ^uploads/.*\.(?:php|phtml|phar|pht|cgi|pl)$ - [F,NC]

  # 1) Redirect "/index.php" (or "dir/index.php") to its clean folder URL
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) Redirect any other "*.php" GET request to the extension-less URL
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 3) Serve the extension-less URL from the real .php file (internal rewrite)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
