# SignalMasterAi connector - copy to .env and edit. Never commit the real file.
#
# ---- the signal site -------------------------------------------------------
SMA_SITE=https://signals.example.com
SMA_TOKEN=                      # Account page -> API token. Shown once.
SMA_WEBHOOK_SECRET=             # only if you receive the webhook instead of polling

# ---- where orders go -------------------------------------------------------
BACKEND=paper                   # paper | ccxt.  Start on paper.
EXCHANGE=binanceusdm            # any ccxt id: bybit, okx, kucoinfutures, ...
MARKET_TYPE=swap                # swap | spot
SANDBOX=0                       # 1 = the exchange's testnet, where it has one
QUOTE=USDT
API_KEY=
API_SECRET=
API_PASSWORD=                   # OKX / KuCoin passphrase

# ---- the two locks on live trading ----------------------------------------
DRY_RUN=1                       # 1 = decide and log, place nothing
I_UNDERSTAND_THE_RISK=          # must be exactly: yes

# ---- which signals to take -------------------------------------------------
MIN_GRADE=B                     # A+, A, B, C, D
MIN_RR_TIER=1                   # 1 = 1:1 and up, 2 = 1:2 and up, 3 = only 1:3
SIDES=BUY,SELL
SYMBOLS=                        # empty = all. e.g. BTCUSDT,ETHUSDT
TIMEFRAMES=                     # empty = all. e.g. 1h,4h
MAX_AGE_MINUTES=30              # ignore a call older than this
MAX_OPEN_TRADES=3

# ---- how big ---------------------------------------------------------------
RISK_PCT=1                      # percent of free balance the stop may cost
MAX_NOTIONAL=0                  # 0 = uncapped
LEVERAGE=3
MARGIN_MODE=isolated
ENTRY=market                    # market | limit (limit uses the plan's entry)
TP_SPLIT=0.5,0.3,0.2            # how the size is shared across TP1/TP2/TP3

# ---- Telegram: watch it and stop it, from your phone -----------------------
# YOUR bot, not the signal site's. @BotFather -> /newbot -> paste the token.
# TG_CHAT_ID is your own chat: message the bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read message.chat.id
# Leave the token blank and none of this runs.
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_MODE=notify                  # notify = it trades and tells you
                                # confirm = nothing is placed until you tap Take
CONFIRM_MINUTES=15              # how long a question stays answerable
# TG_API_BASE=https://api.telegram.org   # only if you reach Telegram via a proxy

# ---- housekeeping ----------------------------------------------------------
POLL_SECONDS=60
STATE_FILE=state.json
LOG_FILE=trades.log
PAPER_BALANCE=10000
