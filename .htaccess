# =====================================================================
# TECHBISS — Apache configuration
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the site lives in a sub-directory, set RewriteBase to it, e.g.
    # RewriteBase /techbiss/
    # RewriteBase /

    # -----------------------------------------------------------------
    # Canonical host
    # -----------------------------------------------------------------
    # www and non-www both work as shipped: nothing here forces one, and
    # the application builds its links relative to whichever host the
    # visitor used, so sessions and forms stay on that host either way.
    # The canonical <link> still points at the address configured in
    # Settings, which is what search engines index.
    #
    # To collapse the two into one address, uncomment ONE block below.
    # Point your DNS at both hosts first, or the redirect will lead to a
    # name that does not resolve.
    #
    # Drop the www (https://www.example.com -> https://example.com):
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]
    #
    # Require the www (https://example.com -> https://www.example.com):
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteCond %{HTTP_HOST} !^localhost [NC]
    # RewriteCond %{HTTP_HOST} !^[0-9.]+$
    # RewriteRule ^ %{REQUEST_SCHEME}://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Force HTTPS — uncomment once a certificate is installed.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # -----------------------------------------------------------------
    # Clean URLs — no .php anywhere in the address bar
    # -----------------------------------------------------------------
    # /index.php -> /   and   /anything/index.php -> /anything/
    # Matched against THE_REQUEST so it only fires on what the browser
    # actually asked for, never on a URL we rewrote internally. Limited to
    # GET and HEAD so a POST is never bounced and stripped of its body.
    RewriteCond %{THE_REQUEST} "^(GET|HEAD) /(.*/)?index\.php[?\s]" [NC]
    RewriteRule ^ /%2 [R=301,L]

    # /install.php -> /install, and the same for any other real .php file
    RewriteCond %{THE_REQUEST} "^(GET|HEAD) /([^?\s]+)\.php[?\s]" [NC]
    RewriteRule ^ /%2 [R=301,L]

    # Strip a trailing slash (except on the site root and real directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Serve /install from install.php, and likewise for any other .php file
    # that exists. This is what makes the extensionless address above work.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # Never route real files or directories through the front controller
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Admin has its own front controller
    RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

    # Everything else
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
# Protect application internals
# ---------------------------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.git.*|.*\.sql|.*\.md|.*\.log)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(config|includes|storage|database|tools)(/|$)

# ---------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
    Header unset Server
    # Enable once HTTPS is confirmed working on every subdomain:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>

# ---------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Caching — assets are cache-busted with ?v=, so they can be cached hard
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 week"
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/xml               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /index.php
