# =====================================================================
# TECHBISS — Apache configuration
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the site lives in a sub-directory, set RewriteBase to it, e.g.
    # RewriteBase /techbiss/
    # RewriteBase /

    # Force HTTPS — uncomment once a certificate is installed.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Strip a trailing slash (except on the site root)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Never route real files or directories through the front controller
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Admin has its own front controller
    RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

    # Everything else
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
# Protect application internals
# ---------------------------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.git.*|.*\.sql|.*\.md|.*\.log)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(config|includes|storage|database)(/|$)

# ---------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
    Header unset Server
    # Enable once HTTPS is confirmed working on every subdomain:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>

# ---------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Caching — assets are cache-busted with ?v=, so they can be cached hard
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 week"
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/xml               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /index.php
