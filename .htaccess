Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Never serve config, app internals or the schema over HTTP. Matched at any
# depth so a subdirectory install is covered too; each of those folders also
# carries its own .htaccess, which is what protects them when this file's rules
# are not in play.
RedirectMatch 404 (^|/)(config|app|partials)/
RedirectMatch 404 \.(sql|md|log)$
# Dotfiles stay hidden, but not /.well-known/: blocking it stops Let's Encrypt
# and AutoSSL from answering the challenge, so certificates cannot be issued or
# renewed — on a site whose whole business is running other people's SSL.
RedirectMatch 404 /\.(?!well-known/)

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pretty URLs: /portfolio/my-slug -> portfolio-item.php?slug=my-slug
  RewriteRule ^portfolio/([A-Za-z0-9\-]+)/?$ portfolio-item.php?slug=$1 [L,QSA]
  RewriteRule ^marketplace/([A-Za-z0-9\-]+)/?$ product.php?slug=$1 [L,QSA]
</IfModule>
