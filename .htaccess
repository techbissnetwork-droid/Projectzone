# TECHBISS — Apache configuration for shared / cPanel hosting.

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # robots.txt advertises /sitemap.xml; the generator is sitemap.php.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Send /services to services.php, and so on.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}\.php -f
  RewriteRule ^(.*)$ $1.php [L]

  # Anything else that is not a real file goes to the 404 page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Never serve the config, the database file or anything in app/.
<FilesMatch "^(config\.php|\.env|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite3|db|log|sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Paid deliverables are only ever served by download.php, never directly.
RedirectMatch 403 ^/storage/files/
