# Written by SignalMasterAi. This directory holds the database,
# uploaded files and the local config. None of it is a public document.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
# Belt and braces: never hand anything in here to an interpreter.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
# nginx reads none of the above. Add this to the server block:
#   location ^~ /data/ { deny all; }
