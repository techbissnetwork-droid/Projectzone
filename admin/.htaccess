# Admin is never indexed and has its own front controller.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} \.(css|js|png|jpe?g|svg|webp|woff2?|ico)$
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(php)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

RedirectMatch 404 ^/admin/(controllers|views)(/|$)
