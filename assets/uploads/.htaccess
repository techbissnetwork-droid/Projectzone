# Defence in depth. Uploads here are extension-allowlisted and validated
# with getimagesize(), and filenames are rebuilt server-side, so nothing
# executable should ever land in this folder — but this directory holds
# attacker-influenced bytes, so make sure the server would never run them
# as code even if a future change let something through.
php_flag engine off
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phar|phtml|php[0-9]|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
