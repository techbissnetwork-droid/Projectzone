# Generated by the installer — never commit real database credentials.
/config.php
/install.lock

# Staff-uploaded branding files (logo/favicon/social image), and
# customer-purchased product files — but not the .htaccess that blocks
# direct access to the latter, which must ship with the app.
/assets/uploads/*
!/assets/uploads/.htaccess
!/assets/uploads/.gitkeep
!/assets/uploads/products/
/assets/uploads/products/*
!/assets/uploads/products/.htaccess
