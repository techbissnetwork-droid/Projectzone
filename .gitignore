storage/*.sqlite
storage/*.sqlite3
storage/uploads/*
!storage/uploads/.htaccess
!storage/uploads/.gitkeep

# Files sold through the marketplace. Never in version control.
storage/files/*
!storage/files/.htaccess
!storage/files/.gitkeep

